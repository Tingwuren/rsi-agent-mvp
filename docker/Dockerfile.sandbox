# Minimal hardened sandbox image for RSI Agent MVP DockerSandbox
# Build: docker build -t rsi-sandbox:py311 -f docker/Dockerfile.sandbox .
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --no-cache-dir pytest>=8.0 sympy>=1.13

# Non-root runtime user (matches DockerSandbox --user 65534:65534)
USER 65534:65534
WORKDIR /tmp
