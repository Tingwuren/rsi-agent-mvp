# All large caches, models, adapters, and run artifacts MUST reside on /mnt/data0
# (system root partition "/" has limited free space).
RSI_WORKSPACE_ROOT=/mnt/data0/Projects/rsi-agent-mvp/.workspace

HF_HOME=/mnt/data0/Projects/rsi-agent-mvp/.workspace/hf_cache
HF_DATASETS_CACHE=/mnt/data0/Projects/rsi-agent-mvp/.workspace/hf_cache/datasets
PIP_CACHE_DIR=/mnt/data0/Projects/rsi-agent-mvp/.workspace/pip_cache
TMPDIR=/mnt/data0/Projects/rsi-agent-mvp/.workspace/tmp

# Default free RTX 5090 GPU on this host (adjust if another GPU is free)
CUDA_VISIBLE_DEVICES=1

# OpenAI-compatible inference endpoint (local vLLM or external API)
RSI_LLM_BASE_URL=http://127.0.0.1:8000/v1
RSI_LLM_API_KEY=EMPTY
